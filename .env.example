# Copy this file to .env and fill in real values for local development.
# .env is gitignored and must never be committed.
#
# These values correspond 1:1 to the CONFIGURATION constants at the top of
# each HTML file. Since the pages are static HTML/JS with no build step,
# these values are not auto-injected — use this file as your local reference
# when editing the CONFIGURATION block in each file, or wire up a small
# templating/build step if you add one later.

# --- now-playing-ha.html ---
DEV_MODE=true
MEDIA_PLAYER=media_player.sonos_roam
API_PATH=/api/ha
HA_LONG_LIVED_ACCESS_TOKEN=

# --- now-playing-ma.html ---
MA_ACCESS_TOKEN=
PLAYER_ID=
MA_WS_URL=ws://192.168.1.20:8095/ws
MA_BASE_URL=http://192.168.1.20:8095

# --- discover-players-ma.html ---
# (reuses MA_ACCESS_TOKEN and MA_WS_URL above)
